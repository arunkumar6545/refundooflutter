<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude ALL SharedPreferences and secure storage from Android Auto Backup.
  Refund data, auth tokens and user prefs must never leave the device.
-->
<full-backup-content>
    <!-- Exclude the entire shared_prefs folder -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude Flutter secure storage files -->
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
